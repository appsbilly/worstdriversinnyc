# NYC SODA API. optional but recommended (raises throttling limits)
NYC_OPEN_DATA_APP_TOKEN=

# Upstash Redis (free tier works). REQUIRED for caching + rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used by /api/waitlist as the destination address for non-NYC waitlist signups
WAITLIST_EMAIL_DESTINATION=

# Email shown in the footer + on the methodology page for takedown requests
DMCA_CONTACT_EMAIL=

# Public site URL (used for absolute OG image URLs + sitemap)
NEXT_PUBLIC_SITE_URL=https://platerank.com

# Plausible analytics domain (omit to disable)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Shared secret required to hit the /api/cron/leaderboard endpoint.
# Vercel Cron will send this automatically as a Bearer token if configured.
CRON_SECRET=
